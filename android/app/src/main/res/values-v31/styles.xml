<?xml version="1.0" encoding="utf-8"?>
<resources>
  <style name="LaunchTheme" parent="Theme.AppCompat.Light.NoActionBar">
    <!-- ANDROID 12+ splash keys -->
    <item name="android:windowSplashScreenBackground">@color/splash_color</item>
    <item name="android:windowSplashScreenAnimatedIcon">@mipmap/launcher_icon</item>
    <!-- optional (keep transparent if you don't want a circle behind the icon) -->
    <item name="android:windowSplashScreenIconBackgroundColor">@android:color/transparent</item>

    <!-- keep your other flags -->
    <item name="android:forceDarkAllowed">false</item>
    <item name="android:windowFullscreen">true</item>
    <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
  </style>

  <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
    <item name="android:windowBackground">?android:colorBackground</item>
  </style>
</resources>
